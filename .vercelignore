# Aggressive exclusions to prevent micromatch stack overflow
node_modules/**/*
.next/**/*
.git/**/*
out/**/*
build/**/*
coverage/**/*

# Generated/temp files that cause trace collection issues
*.log
*.pem
.DS_Store
.vscode/**/*
.env*
summary.md
generate-icons.js
generate-icons.html
resend.txt

# Exclude heavy icon assets (keep only essentials)
public/icons/**/*
public/icons/icon-192x192.png
public/icons/icon-512x512.png

# Keep only essential files for build
!package.json
!package-lock.json
!next.config.js
!tsconfig.json
!tailwind.config.ts
!postcss.config.js
!components.json
!.vercelignore

# Keep source code and essential public assets
!src/**/*
!public/manifest.json
!public/sw.js
!public/offline.html
!public/favicon.ico