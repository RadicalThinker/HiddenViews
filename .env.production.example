# Production Environment Variables
# Copy this file to .env.production and fill in your production values

# NextAuth Configuration
NEXTAUTH_SECRET=your-production-secret-here
NEXTAUTH_URL=https://hiddenreviews.yashvrawat.in

# Database
MONGODB_URI=your-production-mongodb-uri

# Email Service (Resend)
RESEND_API_KEY=your-production-resend-api-key
EMAIL_FROM="HiddenViews <verify@hiddenreviews.yashvrawat.in>"

# Optional: comma-separated extra browser origins allowed to call the API
ALLOWED_ORIGINS=

# AI Service (Google Gemini)
GEMINI_API_KEY=your-production-gemini-api-key

# Node Environment
NODE_ENV=production
